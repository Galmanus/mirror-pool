[0.014462, "o", "  \u001b[1mriverrun  ·  your privacy status\u001b[0m\r\n  \u001b[2m────────────────────────────────────────────────────────\u001b[0m\r\n   \u001b[2m○\u001b[0m  \u001b[2mNOT CONNECTED\u001b[0m   no identity active. run `riverrun connect` to start\r\n   \u001b[1;32m⚛\u001b[0m  \u001b[1mpost-quantum \u001b[0m   \u001b[1;32mON  (hash-based, harvest-now-decrypt-later proof)\u001b[0m\r\n   \u001b[36m◆\u001b[0m  \u001b[1midentity     \u001b[0m   \u001b[2ma different, unlinkable face in every app\u001b[0m\r\n   \u001b[1;33m⚑\u001b[0m  \u001b[1mreal anonymity\u001b[0m   \u001b[2mrun `riverrun preflight <wallet>` to measure yours\u001b[0m\r\n  \u001b[2m────────────────────────────────────────────────────────\u001b[0m\r\n  \u001b[2msimple:  connect  ·  disconnect  ·  status  ·  guide\u001b[0m\r\n\r\n  \u001b[2mnote: riverrun makes you unlinkable, it does not hide that you transacted.\u001b[0m\r\n\r\n  \u001b[1mWhat would you like to do?\u001b[0m\r\n\r\n    \u001b[1;32m1\u001b[0m  \u001b[1mAm I e"]
[0.014651, "o", "xposed?       \u001b[0m  \u001b[2mcheck your real anonymity before you act\u001b[0m\r\n    \u001b[1;32m2\u001b[0m  \u001b[1mCreate an identity  \u001b[0m  \u001b[2mone secret, a different face in every app\u001b[0m\r\n    \u001b[1;32m3\u001b[0m  \u001b[1mWhen to refresh?    \u001b[0m  \u001b[2mhow an identity wears out with use\u001b[0m\r\n    \u001b[1;32m4\u001b[0m  \u001b[1mMeasure a pool      \u001b[0m  \u001b[2mits real anonymity vs what it advertises\u001b[0m\r\n    \u001b[36mc\u001b[0m  \u001b[1mConnect / disconnect\u001b[0m  \u001b[2mactivate or clear your identity\u001b[0m\r\n    \u001b[2mq\u001b[0m  \u001b[2mquit\u001b[0m\r\n\r\n  \u001b[36m›\u001b[0m "]
[2.213295, "o", "\r\n  \u001b[1mLet's create your private identity.\u001b[0m\r\n"]
[2.213447, "o", "  \u001b[2mOne secret becomes a different, unlinkable identity in every app you use.\u001b[0m\r\n\r\n  \u001b[1;32m✓\u001b[0m your secret (write it down, it is your whole identity):\r\n      \u001b[1mb2d9a47d8b2d8ba7d4db653623a45771e0873a72f47ae6e0984966b2ea387b6f\u001b[0m\r\n\r\n  \u001b[36m›\u001b[0m which app or place? (e.g. dao-vote, airdrop) › "]
[4.414771, "o", "\r\n  \u001b[1;32m✓\u001b[0m your identity for \u001b[36mdao-vote\u001b[0m\r\n      \u001b[2mwho you are :\u001b[0m \u001b[1m8920ee99072b\u001b[0m   \u001b[2mnobody can link this to your other apps\u001b[0m\r\n      \u001b[2mone action  :\u001b[0m \u001b[1m4f0d1b3b763f\u001b[0m   \u001b[2mspend once, e.g. one vote or one claim\u001b[0m\r\n  \u001b[36m›\u001b[0m another one? (or press Enter to finish) › "]
[7.015968, "o", "\r\n  \u001b[1;32m✓\u001b[0m your identity for \u001b[36mairdrop\u001b[0m\r\n      \u001b[2mwho you are :\u001b[0m \u001b[1mb39bb4ff469e\u001b[0m   \u001b[2mnobody can link this to your other apps\u001b[0m\r\n      \u001b[2mone action  :\u001b[0m \u001b[1m35f8abbc2285\u001b[0m   \u001b[2mspend once, e.g. one vote or one claim\u001b[0m\r\n\r\n  \u001b[1;33m→\u001b[0m your two identities are completely different.\r\n      \u001b[2mthat is the whole point: one secret, and no one can connect them to you.\u001b[0m\r\n  \u001b[36m›\u001b[0m another one? (or press Enter to finish) › "]
[9.817595, "o", "\r\n\r\n  \u001b[1mWhat would you like to do?\u001b[0m\r\n\r\n    \u001b[1;32m1\u001b[0m  \u001b[1mAm I exposed?       \u001b[0m  \u001b[2mcheck your real anonymity before you act\u001b[0m\r\n    \u001b[1;32m2\u001b[0m  \u001b[1mCreate an identity  \u001b[0m  \u001b[2mone secret, a different face in every app\u001b[0m\r\n    \u001b[1;32m3\u001b[0m  \u001b[1mWhen to refresh?    \u001b[0m  \u001b[2mhow an identity wears out with use\u001b[0m\r\n    \u001b[1;32m4\u001b[0m  \u001b[1mMeasure a pool      \u001b[0m  \u001b[2mits real anonymity vs what it advertises\u001b[0m\r\n    \u001b[36mc\u001b[0m  \u001b[1mConnect / disconnect\u001b[0m  \u001b[2mactivate or clear your identity\u001b[0m\r\n    \u001b[2mq\u001b[0m  \u001b[2mquit\u001b[0m\r\n\r\n  \u001b[36m›\u001b[0m "]
