[37.188073, "o", "\r     \u001b[2mone action  (fit)  \u001b[0m  \u001b[1m1deb6c2fde170a8ac59beee8a9acda5a\u001b[0m  \u001b[1;32m✓\u001b[0m        \r\n     \u001b[2mnobody can link these to you, or to your other apps.\u001b[0m\r\n\r\n  \u001b[1;33m→\u001b[0m your two identities are completely different.\r\n      \u001b[2mthat is the whole point: one secret, and no one can connect them to you.\u001b[0m\r\n  \u001b[36m›\u001b[0m another one? (or press Enter to finish) › "]
[38.114128, "o", "\r\n\r\n  \u001b[1mWhat would you like to do?\u001b[0m\r\n\r\n    \u001b[36m1\u001b[0m   \u001b[1mBecome anonymous  \u001b[0m   \u001b[2mthe step-by-step to disappear on Solana\u001b[0m\r\n    \u001b[36m2\u001b[0m   \u001b[1mAm I exposed?     \u001b[0m   \u001b[2mcheck your anonymity right now\u001b[0m\r\n    \u001b[36m3\u001b[0m   \u001b[1mCreate an identity\u001b[0m   \u001b[2mone secret, a different face in every app\u001b[0m\r\n    \u001b[36m4\u001b[0m   \u001b[1mMeasure a pool    \u001b[0m   \u001b[2mits real anonymity vs what it advertises\u001b[0m\r\n\r\n"]
[38.114214, "o", "    \u001b[2mc\u001b[0m   \u001b[2mconnect / disconnect\u001b[0m   \u001b[2mactivate or clear your identity\u001b[0m\r\n    \u001b[2mq\u001b[0m   \u001b[2mquit\u001b[0m\r\n\r\n  \u001b[36m›\u001b[0m "]
[39.915699, "o", "  stay private.\r\n"]
