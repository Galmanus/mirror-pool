[4.813387, "o", "\r\n  \u001b[36m2\u001b[0m  \u001b[1mUse a fresh wallet for the sensitive action\u001b[0m\r\n     \u001b[2mA new wallet with no history that ties it to you.\u001b[0m\r\n     \u001b[36msolana-keygen new -o fresh.json\u001b[0m   \u001b[2m(riverrun never sees your keys)\u001b[0m\r\n\r\n"]
[4.813585, "o", "  \u001b[36m3\u001b[0m  \u001b[1mFund it into a crowd\u001b[0m\r\n     \u001b[2mFund the fresh wallet from an origin many people share, so you blend in.\u001b[0m\r\n     \u001b[1;32mdo   \u001b[0m  \u001b[2mwithdraw to it from a major exchange: thousands share that origin\u001b[0m\r\n     \u001b[1;31mavoid\u001b[0m  \u001b[2mfunding it from your current wallet, that re-links you at once\u001b[0m\r\n\r\n  \u001b[36m4\u001b[0m  \u001b[1mAct, then verify you disappeared\u001b[0m\r\n     \u001b[2mDo your action from the fresh wallet, then check your anonymity:\u001b[0m\r\n     \u001b[36m›\u001b[0m the fresh wallet, to verify (or Enter to skip) › "]
[8.214965, "o", "\r\n  \u001b[1;32m✓\u001b[0m  \u001b[2mriverrun keeps watching and warns you if your crowd shrinks.\u001b[0m\r\n\r\n\r\n  \u001b[1mWhat would you like to do?\u001b[0m\r\n\r\n    \u001b[36m1\u001b[0m   \u001b[1mBecome anonymous  \u001b[0m   \u001b[2mthe step-by-step to disappear on Solana\u001b[0m\r\n    \u001b[36m2\u001b[0m   \u001b[1mAm I exposed?     \u001b[0m   \u001b[2mcheck your anonymity right now\u001b[0m\r\n    \u001b[36m3\u001b[0m   \u001b[1mCreate an identity\u001b[0m   \u001b[2mone secret, a different face in every app\u001b[0m\r\n    \u001b[36m4\u001b[0m   \u001b[1mMeasure a pool    \u001b[0m   \u001b[2mits real anonymity vs what it advertises\u001b[0m\r\n\r\n    \u001b[2mc\u001b[0m   \u001b[2mconnect / disconnect\u001b[0m   \u001b[2mactivate or clear your identity\u001b[0m\r\n    \u001b[2mq\u001b[0m   \u001b[2mquit\u001b[0m\r\n\r\n  \u001b[36m›\u001b[0m "]
