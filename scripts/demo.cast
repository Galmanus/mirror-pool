[11.868009, "o", "\r\n\u001b[1;38;5;46mriverrun: post-quantum engine initialized\u001b[0m\r\n"]
[12.571821, "o", "\u001b[H\u001b[2J\u001b[3J"]
[12.603488, "o", "\r\n  \u001b[36m              ██\u001b[0m\r\n  \u001b[36m              ▀▀\u001b[0m\r\n  \u001b[36m  ██▄████   ████     ██▄  ▄██   ▄████▄    ██▄████   ██▄████  ██    ██  ██▄████▄\u001b[0m\r\n  \u001b[36m  ██▀         ██      ██  ██   ██▄▄▄▄██   ██▀       ██▀      ██    ██  ██▀   ██\u001b[0m\r\n  \u001b[36m  ██          ██      ▀█▄▄█▀   ██▀▀▀▀▀▀   ██        ██       ██    ██  ██    ██\u001b[0m\r\n  \u001b[36m  ██       ▄▄▄██▄▄▄    ████    ▀██▄▄▄▄█   ██        ██       ██▄▄▄███  ██    ██\u001b[0m\r\n  \u001b[36m  ▀▀       ▀▀▀▀▀▀▀▀     ▀▀       ▀▀▀▀▀    ▀▀        ▀▀        ▀▀▀▀ ▀▀  ▀▀    ▀▀\u001b[0m\r\n\r\n       \u001b[2manonymity on Solana   ·   post-quantum   ·   you can measure it\u001b[0m\r\n  \u001b[2m───────────────"]
[12.603681, "o", "───────────────────────────────────────────────────────────\u001b[0m\r\n\r\n    \u001b[2m○\u001b[0m  \u001b[2mstatus       \u001b[0m  \u001b[2mnot connected\u001b[0m  \u001b[2m· run \u001b[36mriverrun connect\u001b[0m\u001b[0m\r\n    \u001b[1;32m●\u001b[0m  \u001b[2mpost-quantum \u001b[0m  on, everlasting  \u001b[2m· \u001b[36mriverrun pq\u001b[0m\u001b[0m\r\n    \u001b[36m●\u001b[0m  \u001b[2midentity     \u001b[0m  \u001b[2ma different, unlinkable face in every app\u001b[0m\r\n\r\n    \u001b[2mmeasure yours\u001b[0m  \u001b[36mriverrun preflight <wallet>\u001b[0m\r\n\r\n  \u001b[1mWhat would you like to do?\u001b[0m\r\n\r\n    \u001b[36m1\u001b[0m   \u001b[1mBecome anonymous  \u001b[0m   \u001b[2mthe step-by-step to disappear on Solana\u001b[0m\r\n    \u001b[36m2\u001b[0m   \u001b[1mAm I exposed?     \u001b[0m   \u001b[2mcheck your anonymity right now\u001b[0m\r\n    \u001b[36m3\u001b[0m   \u001b[1mCreate an identity\u001b[0m   \u001b[2mone secret, a different face in every app\u001b[0m\r\n    \u001b[36m4\u001b[0m   \u001b[1mMeasure a pool    \u001b[0m   \u001b[2mits real anonymity vs what it advertises\u001b[0m\r\n\r\n    \u001b[2mc\u001b[0m   \u001b[2mconnect / disconnect\u001b[0m   \u001b[2mactivate or cl"]
[12.60378, "o", "ear your identity\u001b[0m\r\n    \u001b[2mq\u001b[0m   \u001b[2mquit\u001b[0m\r\n\r\n  \u001b[36m›\u001b[0m "]
[14.77701, "o", "\r\n  \u001b[1mBecome anonymous on Solana\u001b[0m\r\n  \u001b[2mBreak the link between you and what you do. Not hiding the transaction,\u001b[0m\r\n  \u001b[2mhiding WHO did it. Four steps. riverrun never touches your keys.\u001b[0m\r\n\r\n  \u001b[36m1\u001b[0m  \u001b[1mWhere are you now?\u001b[0m\r\n     \u001b[36m›\u001b[0m the wallet you use today (or Enter to skip) › "]
[17.38056, "o", "\r\n  \u001b[36m2\u001b[0m  \u001b[1mUse a fresh wallet for the sensitive action\u001b[0m\r\n     \u001b[2mA new wallet with no history that ties it to you.\u001b[0m\r\n     \u001b[36msolana-keygen new -o fresh.json\u001b[0m   \u001b[2m(riverrun never sees your keys)\u001b[0m\r\n\r\n  \u001b[36m3\u001b[0m  \u001b[1mFund it into a crowd\u001b[0m\r\n     \u001b[2mFund the fresh wallet from an origin many people share, so you blend in.\u001b[0m\r\n     \u001b[1;32mdo   \u001b[0m  \u001b[2mwithdraw to it from a major exchange: thousands share that origin\u001b[0m\r\n"]
[17.380736, "o", "     \u001b[1;31mavoid\u001b[0m  \u001b[2mfunding it from your current wallet, that re-links you at once\u001b[0m\r\n\r\n  \u001b[36m4\u001b[0m  \u001b[1mAct, then verify you disappeared\u001b[0m\r\n     \u001b[2mDo your action from the fresh wallet, then check your anonymity:\u001b[0m\r\n     \u001b[36m›\u001b[0m the fresh wallet, to verify (or Enter to skip) › "]
[20.782916, "o", "\r\n  \u001b[1;32m✓\u001b[0m  \u001b[2mriverrun keeps watching and warns you if your crowd shrinks.\u001b[0m\r\n\r\n\r\n  \u001b[1mWhat would you like to do?\u001b[0m\r\n\r\n    \u001b[36m1\u001b[0m   \u001b[1mBecome anonymous  \u001b[0m   \u001b[2mthe step-by-step to disappear on Solana\u001b[0m\r\n    \u001b[36m2\u001b[0m   \u001b[1mAm I exposed?     \u001b[0m   \u001b[2mcheck your anonymity right now\u001b[0m\r\n    \u001b[36m3\u001b[0m   \u001b[1mCreate an identity\u001b[0m   \u001b[2mone secret, a different face in every app\u001b[0m\r\n    \u001b[36m4\u001b[0m   \u001b[1mMeasure a pool    \u001b[0m   \u001b[2mits real anonymity vs what it advertises\u001b[0m\r\n\r\n    \u001b[2mc\u001b[0m   \u001b[2mconnect / disconnect\u001b[0m   \u001b[2mactivate or clear your identity\u001b[0m\r\n    \u001b[2mq\u001b[0m   \u001b[2mquit\u001b[0m\r\n\r\n  \u001b[36m›\u001b[0m "]
[22.784496, "o", "\r\n  \u001b[1mLet's create your private identity.\u001b[0m\r\n  \u001b[2mOne secret becomes a different, unlinkable identity in every app you use.\u001b[0m\r\n\r\n  \u001b[36m◈\u001b[0m \u001b[2mgenerating a 256-bit post-quantum secret…\u001b[0m\r\n"]
