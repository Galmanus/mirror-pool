[0.010397, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.012803, "o", "\u001b[1;38;5;37mriverrun ID\u001b[0m  one secret, a different unlinkable identity in every context\r\n\r\n"]
[1.014541, "o", "\u001b[38;5;37m$\u001b[0m riverrun id new\r\n"]
[1.52257, "o", "your riverrun ID secret (keep it safe, it is your whole identity):\r\n  9e31472bf3011a601b8ee04c1b4900579c7fb2455943482ed0087270b4a545ce\r\n\r\n"]
[2.924497, "o", "\u001b[38;5;37m$\u001b[0m riverrun id show 9e31472bf3011a601b8ee04c1b4900579c7fb2455943482ed0087270b4a545ce dao-vote\r\n"]
[3.428128, "o", "context: dao-vote\r\n  shape (your identity here) : f2a82d952ab104e9daedf7c3e83d2fdafb5b910c085ceabc096a57416dfbbe5f\r\n  fit   (your one action)    : 4eee25ca32134c7755c7806f6eedb08928e61ca7443c52e4c6383001fa57a017\r\n  turn  (continuity tag, ZK) : 5564d3bfebcd96055a16962ea68ec78e0d86d76cc0c9397a2222e2f16a47360c\r\n\r\nthe same secret in another context gives a different, unlinkable shape.\r\n"]
[3.428562, "o", "\r\n"]
[4.630247, "o", "\u001b[38;5;37m$\u001b[0m riverrun id show 9e31472bf3011a601b8ee04c1b4900579c7fb2455943482ed0087270b4a545ce airdrop\r\n"]
[5.134226, "o", "context: airdrop\r\n  shape (your identity here) : d897966c7eb8a26e2eb4867e252c0e0f71b1fcd5443b75319db5a302d8e38a64\r\n  fit   (your one action)    : 46ecf22c27088fa6d60c7f1132e12420996a66548642b63d7ac5a82a0de0a81a\r\n  turn  (continuity tag, ZK) : ebfa32b8663377dc04aaaa71b2a4ebdf91a7f751a954cfd6b1349e57192e5cd5\r\n\r\nthe same secret in another context gives a different, unlinkable shape.\r\n"]
[5.134621, "o", "\r\n"]
[6.336336, "o", "\u001b[38;5;244m  ^ same secret, two contexts, two identities nobody can link back to you.\u001b[0m\r\n\r\n"]
[7.938231, "o", "\u001b[38;5;37m$\u001b[0m riverrun id erosion\r\n"]
[8.442125, "o", "repeated-use erosion of one persistent identity (floor k_min = 4):\r\n\r\n  after use 1: effective anonymity =  6.0\r\n  after use 2: effective anonymity =  3.0  <- below the floor\r\n  after use 3: effective anonymity =  1.0  <- below the floor\r\n\r\nrotate (turn) before use 2: acting again under this secret drops you below the floor.\r\nturn resets the secret; re-fund from a common origin to reset provenance too.\r\n"]
[8.442577, "o", "\r\n"]
[9.644224, "o", "\u001b[1;38;5;37mmeasured privacy, from the terminal.\u001b[0m  full paper: paper/riverrun.pdf\r\n\r\n"]
